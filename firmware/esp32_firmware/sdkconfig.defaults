# Micro-ROS ESP-IDF Configuration
CONFIG_ESP_MAIN_TASK_STACK_SIZE=5000
CONFIG_ESP_TASK_WDT=n

# micro-ROS XRCE-DDS over UART
CONFIG_MICRO_ROS_ESP_XRCE_DDS_MIDDLEWARE=y
CONFIG_MICRO_ROS_ESP_UART_TRANSPORT=y
CONFIG_MICROROS_UART_TXD=-1
CONFIG_MICROROS_UART_RXD=-1
CONFIG_MICROROS_UART_RTS=-1
CONFIG_MICROROS_UART_CTS=-1

# Silence console on UART0 so boot logs never corrupt micro-ROS serial frames
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_NONE=y

# FreeRTOS 1000Hz tick rate
CONFIG_FREERTOS_HZ=1000
