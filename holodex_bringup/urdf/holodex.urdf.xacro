<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="holodex_orange">

  <!-- Propriedades Geométricas Configuráveis -->
  <xacro:property name="wheel_radius" value="0.050" />
  <xacro:property name="wheel_width" value="0.045" />
  <xacro:property name="track_width" value="0.390" />
  <xacro:property name="wheel_base" value="0.380" />

  <!-- Posição da Câmera Astra Pro -->
  <xacro:property name="camera_offset_x" value="0.180" />
  <xacro:property name="camera_offset_y" value="0.000" />
  <xacro:property name="camera_offset_z" value="0.150" />
  <xacro:property name="camera_pitch" value="0.000" />

  <!-- Posição da IMU BMI160 -->
  <xacro:property name="imu_offset_x" value="0.000" />
  <xacro:property name="imu_offset_y" value="0.000" />
  <xacro:property name="imu_offset_z" value="0.060" />

  <!-- Materiais -->
  <material name="chassis_grey">
    <color rgba="0.2 0.2 0.22 1.0"/>
  </material>
  <material name="wheel_black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  <material name="astra_cyan">
    <color rgba="0.0 0.6 0.7 1.0"/>
  </material>
  <material name="imu_red">
    <color rgba="0.8 0.1 0.1 1.0"/>
  </material>

  <!-- 1. Referencial do solo (base_footprint) -->
  <link name="base_footprint"/>

  <!-- 2. Centro geométrico do chassi (base_link) -->
  <link name="base_link">
    <visual>
      <origin xyz="0.0 0.0 0.04" rpy="0 0 0"/>
      <geometry>
        <box size="0.45 0.35 0.08"/>
      </geometry>
      <material name="chassis_grey"/>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.04" rpy="0 0 0"/>
      <geometry>
        <box size="0.45 0.39 0.12"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <mass value="4.5"/>
      <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.07" iyz="0" izz="0.10"/>
    </inertial>
  </link>

  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0.0 0.0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- 3. Sensor Inercial (imu_link) -->
  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.02 0.005"/>
      </geometry>
      <material name="imu_red"/>
    </visual>
  </link>

  <joint name="base_to_imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="${imu_offset_x} ${imu_offset_y} ${imu_offset_z}" rpy="0 0 0"/>
  </joint>

  <!-- 4. Câmera Orbbec Astra Pro (camera_link) -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.165 0.035"/>
      </geometry>
      <material name="astra_cyan"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.17 0.04"/>
      </geometry>
    </collision>
  </link>

  <joint name="base_to_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${camera_offset_x} ${camera_offset_y} ${camera_offset_z}" rpy="0 ${camera_pitch} 0"/>
  </joint>

  <!-- Macro para Rodas Mecanum -->
  <xacro:macro name="mecanum_wheel" params="prefix x_reflect y_reflect">
    <link name="wheel_${prefix}_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wheel_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
    </link>

    <joint name="wheel_${prefix}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="wheel_${prefix}_link"/>
      <origin xyz="${x_reflect * wheel_base / 2.0} ${y_reflect * track_width / 2.0} 0.0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:mecanum_wheel prefix="fl" x_reflect="1"  y_reflect="1" />
  <xacro:mecanum_wheel prefix="fr" x_reflect="1"  y_reflect="-1" />
  <xacro:mecanum_wheel prefix="rl" x_reflect="-1" y_reflect="1" />
  <xacro:mecanum_wheel prefix="rr" x_reflect="-1" y_reflect="-1" />

</robot>
