<?xml version="1.0"?>
<robot name="holodex_orange">

  <!-- Materiais -->
  <material name="chassis_grey">
    <color rgba="0.2 0.2 0.22 1.0"/>
  </material>
  <material name="wheel_black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  <material name="astra_cyan">
    <color rgba="0.0 0.6 0.7 1.0"/>
  </material>
  <material name="imu_red">
    <color rgba="0.8 0.1 0.1 1.0"/>
  </material>

  <!-- 1. Referencial do solo (base_footprint) -->
  <link name="base_footprint"/>

  <!-- 2. Centro geométrico e cinemático do chassi (base_link) -->
  <link name="base_link">
    <visual>
      <origin xyz="0.0 0.0 0.04" rpy="0 0 0"/>
      <geometry>
        <box size="0.45 0.35 0.08"/>
      </geometry>
      <material name="chassis_grey"/>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.04" rpy="0 0 0"/>
      <geometry>
        <box size="0.45 0.39 0.12"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <mass value="4.5"/>
      <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.07" iyz="0" izz="0.10"/>
    </inertial>
  </link>

  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0.0 0.0 0.050" rpy="0 0 0"/>
  </joint>

  <!-- 3. Sensor Inercial (imu_link) - BMI160 -->
  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.02 0.005"/>
      </geometry>
      <material name="imu_red"/>
    </visual>
  </link>

  <joint name="base_to_imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.0 0.0 0.060" rpy="0 0 0"/>
  </joint>

  <!-- 4. Câmera RGB-D (camera_link) - Orbbec Astra Pro -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.165 0.035"/>
      </geometry>
      <material name="astra_cyan"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.17 0.04"/>
      </geometry>
    </collision>
  </link>

  <joint name="base_to_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.180 0.0 0.150" rpy="0 0 0"/>
  </joint>

  <!-- 5. Rodas Mecanum 4WD (50mm raio, bitola 390mm, entre-eixos 380mm) -->
  <!-- Roda Dianteira Esquerda (Front-Left) -->
  <link name="wheel_fl_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.050" length="0.045"/>
      </geometry>
      <material name="wheel_black"/>
    </visual>
  </link>
  <joint name="wheel_fl_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_fl_link"/>
    <origin xyz="0.190 0.195 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Roda Dianteira Direita (Front-Right) -->
  <link name="wheel_fr_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.050" length="0.045"/>
      </geometry>
      <material name="wheel_black"/>
    </visual>
  </link>
  <joint name="wheel_fr_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_fr_link"/>
    <origin xyz="0.190 -0.195 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Roda Traseira Esquerda (Rear-Left) -->
  <link name="wheel_rl_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.050" length="0.045"/>
      </geometry>
      <material name="wheel_black"/>
    </visual>
  </link>
  <joint name="wheel_rl_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_rl_link"/>
    <origin xyz="-0.190 0.195 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Roda Traseira Direita (Rear-Right) -->
  <link name="wheel_rr_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.050" length="0.045"/>
      </geometry>
      <material name="wheel_black"/>
    </visual>
  </link>
  <joint name="wheel_rr_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_rr_link"/>
    <origin xyz="-0.190 -0.195 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

</robot>
